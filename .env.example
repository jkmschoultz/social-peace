# Copy to .env and fill in. .env is gitignored.

# --- Stock asset fetching (optional; only needed for `fetch` / `pipeline`) ---
PIXABAY_API_KEY=
PEXELS_API_KEY=
# CC0 audio beds from Freesound (token from https://freesound.org/apiv2/apply/).
# Without it, `pipeline` skips audio scraping and uses whatever is in assets/audio/.
FREESOUND_API_KEY=

# --- LLM-written platform captions (optional; needs `pip install -e .[llm]`) ---
# Without it, captions fall back to picking a line from config.yaml's template lists.
ANTHROPIC_API_KEY=

# --- Binary overrides (optional; defaults assume they're on PATH) ---
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN=C:\ffmpeg\bin\ffprobe.exe

# --- YouTube ---
# Path to the OAuth client secret JSON downloaded from Google Cloud Console.
YOUTUBE_CLIENT_SECRET_FILE=secrets/youtube_client_secret.json
# Where the user refresh token gets cached after the first consent flow.
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# --- TikTok (Content Posting API, Direct Post) ---
# App from https://developers.tiktok.com with the Login Kit + Content Posting API
# products and the video.publish scope. Fill these three, then run
# `social-peace tiktok-login` once; tokens are cached at TIKTOK_TOKEN_FILE and
# refreshed automatically. Unaudited apps post SELF_ONLY only, and the target
# account must be private and added as a sandbox Target User.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must match a Redirect URI registered under Login Kit exactly (any HTTPS page).
TIKTOK_REDIRECT_URI=
TIKTOK_TOKEN_FILE=secrets/tiktok_token.json
# Optional bootstrap instead of tiktok-login (e.g. tokens from the OAuth playground).
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_REFRESH_TOKEN=

# --- Instagram Reels ("Manage messaging and content on Instagram" use case) ---
# The setup is auto-detected from the token. Pick ONE:
#
# A) API setup with INSTAGRAM LOGIN (simplest — no Facebook Page):
#    App Dashboard -> your use case -> "API setup with Instagram Login" ->
#    Generate access tokens -> Add account -> copy the token here. That's it —
#    the IG id is read from /me. Needs the `instagram_business_content_publish`
#    permission on the use case.
#      INSTAGRAM_ACCESS_TOKEN = that token (one line, no quotes)
#
# B) API setup with FACEBOOK LOGIN (IG Business/Creator linked to a FB Page):
#    token with instagram_basic, instagram_content_publish, pages_read_engagement,
#    pages_show_list, business_management.
#      INSTAGRAM_ACCESS_TOKEN = that token
#      INSTAGRAM_USER_ID      = NUMERIC IG business account id (~17 digits), from
#                               GET /{page-id}?fields=instagram_business_account
#
# NOT the "Instagram Basic Display" / "Instagram Tester" flow — it cannot publish.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Instagram fetches the video from a public URL. Leave INSTAGRAM_PUBLIC_BASE_URL
# unset to auto-serve each render over an ephemeral `cloudflared` quick tunnel
# (install: https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/),
# or set it to a host you control (R2 / S3 / nginx) where <base>/<filename>.mp4 is served.
INSTAGRAM_PUBLIC_BASE_URL=
# INSTAGRAM_API_VERSION=v21.0
