# Copy to .env and fill in. .env is gitignored.

# --- Stock asset fetching (optional; only needed for `social-peace fetch`) ---
PIXABAY_API_KEY=
PEXELS_API_KEY=

# --- Binary overrides (optional; defaults assume they're on PATH) ---
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN=C:\ffmpeg\bin\ffprobe.exe

# --- YouTube (wired up in the next step) ---
# Path to the OAuth client secret JSON downloaded from Google Cloud Console.
YOUTUBE_CLIENT_SECRET_FILE=secrets/youtube_client_secret.json
# Where the user refresh token gets cached after the first consent flow.
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
