[Unit]
Description=social-peace: render enough new content to keep the posting queue stocked
# If a publish-due run is still going (uploads can take minutes), wait for it.
After=social-peace-publish.service

[Service]
Type=oneshot
WorkingDirectory=%h/Documents/Code/social-peace
ExecStart=%h/Documents/Code/social-peace/scripts/run_daily.sh pipeline
ExecStartPost=%h/Documents/Code/social-peace/scripts/run_daily.sh prune
